# =========================================================
# Pet Assistant - Environment Variables Configuration (.env)
# =========================================================

# ---------------------------------------------------------
# 1. AI Model Provider API Keys (Opsional, bisa juga via UI)
# ---------------------------------------------------------
GOOGLE_AI_STUDIO_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------
# 2. Google OAuth 2.0 (Google Workspace / Fase 8)
# Dapatkan dari Google Cloud Console: https://console.cloud.google.com
# Authorized Redirect URI: http://127.0.0.1:8000/api/google/oauth/callback
# ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=